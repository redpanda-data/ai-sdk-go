{
  "type": "object",
  "additionalProperties": false,
  "required": ["changes", "needs_human", "skipped"],
  "properties": {
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["offering", "field", "old", "new", "source_url", "rule"],
      "properties": {
        "offering": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"},
        "field": {"enum": ["new_model", "new_copy", "price", "limit", "lifecycle", "replacement", "knowledge_cutoff", "release_date", "capability", "location"]},
        "old": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/+-]{0,64}$"},
        "new": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/+-]{0,64}$"},
        "source_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~/%#?=&+:-]*)?$"},
        "rule": {"type": "string", "pattern": "^[a-z]+(-[a-z0-9]+)+$"}}}},
    "needs_human": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["offering", "field", "values", "source_urls", "rule"],
      "properties": {
        "offering": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"},
        "field": {"enum": ["new_model", "new_copy", "price", "limit", "lifecycle", "replacement", "knowledge_cutoff", "release_date", "capability", "location"]},
        "catalogue": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/+-]{0,64}$"},
        "page": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/+-]{0,64}$"},
        "values": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/+-]{0,64}$"}},
        "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~/%#?=&+:-]*)?$"}},
        "rule": {"type": "string", "pattern": "^[a-z]+(-[a-z0-9]+)+$"}}}},
    "skipped": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["offering", "reason", "rule"],
      "properties": {
        "offering": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,79}$"},
        "reason": {"enum": ["not_on_named_sources", "out_of_scope", "limited_availability", "vendor_excluded", "region_not_offered", "copy_unlisted", "fixed_fact_differs"]},
        "rule": {"type": "string", "pattern": "^[a-z]+(-[a-z0-9]+)+$"}}}}
  }
}
